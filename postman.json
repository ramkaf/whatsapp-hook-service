{
  "info": {
    "name": "WhatsApp Connection & Groups API",
    "description": "Baileys WhatsApp connection and group management. Base URL includes /api/v1. Group mutation requests should be run intentionally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Connect WhatsApp",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/whatsapp/connect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "whatsapp",
            "connect"
          ]
        },
        "description": "Initialize a WhatsApp socket or restore an existing session. No request body required."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.test('Response contains connection status', function () {",
              "  pm.expect(pm.response.json()).to.have.property('status');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Connection Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/whatsapp/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "whatsapp",
            "status"
          ]
        },
        "description": "Get connection status, account JID, session information and QR availability."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Valid session status', function () {",
              "  const valid = ['disconnected', 'connecting', 'awaiting_qr', 'connected', 'logged_out', 'error'];",
              "  pm.expect(valid).to.include(pm.response.json().status);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Pairing QR",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/whatsapp/qr",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "whatsapp",
            "qr"
          ]
        },
        "description": "Returns the QR string and QR image as a Base64 data URL when pairing is required."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response includes QR fields', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('qr');",
              "  pm.expect(json).to.have.property('qrDataUrl');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "WhatsApp Groups",
      "description": "Group management APIs. All routes require a connected WhatsApp session. Mutating operations may need admin permissions. No message operations included.",
      "item": [
        {
          "name": "List Joined Groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/whatsapp/groups",
            "description": "Lists groups the connected WhatsApp account belongs to. Read-only. Requires active connection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful HTTP response', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "pm.test('Returns a group array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Group Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/whatsapp/groups/{{groupJid}}",
