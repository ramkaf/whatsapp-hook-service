# Add these to your existing .env; this example is not loaded automatically.
# Generate a private token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Keep this directory private and persistent. One app process per session.

# Default: all joined groups. Empty disables monitoring.
# To restrict: use IDs from GET /whatsapp/groups, separated by commas.
WHATSAPP_MONITORED_GROUP_JIDS=*

