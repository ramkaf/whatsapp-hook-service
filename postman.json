        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/whatsapp/groups",
            "description": "Creates a new WhatsApp group. Mutates WhatsApp state; run intentionally.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Afra Test Group\",\n  \"participants\": [\n    \"{{participantJid}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful HTTP response', function () {",
